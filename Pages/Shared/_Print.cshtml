<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-autoprint>
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
